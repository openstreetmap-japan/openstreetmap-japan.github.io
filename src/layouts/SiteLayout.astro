---
import "../assets/app.css";

type Props = {
  title?: string;
  description?: string;
  /** Page-specific OG image. Absolute URL or root-relative path. */
  image?: string;
  /** og:type ("website" / "article") */
  ogType?: "website" | "article";
};

const {
  title = "OpenStreetMap Japan",
  description = "OpenStreetMap (OSM) は、誰でも自由に地図を使えるよう、みんなでオープンデータの地理情報を作るプロジェクトです。",
  image = "/images/assets/osm_logo.svg",
  ogType = "website",
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://openstreetmap-japan.github.io/");
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const absImage = /^https?:\/\//.test(image) ? image : new URL(image, siteUrl).toString();
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="OpenStreetMap Japan RSS" href="/rss.xml" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:site_name" content="OpenStreetMap Japan" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absImage} />
    <meta property="og:locale" content="ja_JP" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@osmfj" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absImage} />
  </head>

  <body class="min-h-screen bg-gray-100 text-gray-900">
    <header class="bg-white border-b border-gray-200">
      <div class="mx-auto max-w-6xl px-4 pt-6 pb-3 flex items-center gap-4">
        <a href="/" class="flex items-center gap-3">
          <img src="/images/assets/osm_logo.svg" alt="OpenStreetMap Japan ロゴ" class="h-14 w-14" width="56" height="56" />
          <div>
            <div class="text-2xl font-bold tracking-tight text-gray-900 leading-none">OpenStreetMap Japan</div>
            <div class="text-sm text-gray-600 mt-1">自由な地図をみんなの手で / The Free Wiki World Map</div>
          </div>
        </a>
        <ul class="ml-auto flex items-center gap-2">
          <li>
            <a
              href="https://x.com/osmfj"
              target="_blank"
              rel="noopener me"
              title="X (Twitter) @osmfj"
              class="flex h-9 w-9 items-center justify-center rounded-full bg-gray-900 text-white hover:bg-gray-700 transition-colors"
            >
              <svg viewBox="0 0 24 24" class="w-4 h-4" fill="currentColor" aria-hidden="true">
                <path d="M18.244 2H21.5l-7.39 8.45L22.5 22h-6.79l-5.32-6.96L4.4 22H1.14l7.91-9.04L1.5 2h6.96l4.81 6.36L18.244 2Zm-2.38 18h1.83L7.94 4H6.04l9.824 16Z"/>
              </svg>
              <span class="sr-only">X</span>
            </a>
          </li>
          <li>
            <a
              href="https://www.facebook.com/groups/osmjapan"
              target="_blank"
              rel="noopener me"
              title="Facebook グループ OpenStreetMap Japan Community"
              class="flex h-9 w-9 items-center justify-center rounded-full bg-[#1877f2] text-white hover:bg-[#0d5dbf] transition-colors"
            >
              <svg viewBox="0 0 24 24" class="w-4 h-4" fill="currentColor" aria-hidden="true">
                <path d="M22 12.07C22 6.51 17.52 2 12 2S2 6.51 2 12.07c0 4.99 3.66 9.13 8.44 9.88v-6.99H7.9v-2.89h2.54V9.92c0-2.51 1.49-3.9 3.78-3.9 1.09 0 2.24.2 2.24.2v2.46H15.2c-1.24 0-1.63.78-1.63 1.57v1.89h2.78l-.44 2.89h-2.34V22c4.78-.75 8.43-4.89 8.43-9.93Z"/>
              </svg>
              <span class="sr-only">Facebook</span>
            </a>
          </li>
          <li>
            <a
              href="/rss.xml"
              title="RSS フィード"
              class="flex h-9 w-9 items-center justify-center rounded-full bg-[#ee802f] text-white hover:bg-[#c46720] transition-colors"
            >
              <svg viewBox="0 0 24 24" class="w-4 h-4" fill="currentColor" aria-hidden="true">
                <path d="M6.18 17.82a2.18 2.18 0 1 1-4.36 0 2.18 2.18 0 0 1 4.36 0ZM2 9.66v3.04a9.3 9.3 0 0 1 9.3 9.3h3.04A12.34 12.34 0 0 0 2 9.66Zm0-5.66v3.04A14.96 14.96 0 0 1 16.96 22H20A17.99 17.99 0 0 0 2 4Z"/>
              </svg>
              <span class="sr-only">RSS</span>
            </a>
          </li>
        </ul>
      </div>
      <nav class="border-t border-gray-200">
        <ul class="mx-auto max-w-6xl px-2 flex flex-wrap items-stretch text-sm">
          <li>
            <a href="/" class="block px-3 py-2 text-gray-700 hover:bg-gray-50 hover:text-blue-700">Home</a>
          </li>
          <li>
            <a href="https://openstreetmap.org/" class="block px-3 py-2 text-gray-700 hover:bg-gray-50 hover:text-blue-700" title="地図を閲覧し編集できるopenstreetmap.orgへ行きます">OpenStreetMap プロジェクトサイト</a>
          </li>
          <li class="relative group">
            <a href="/events/" class="flex items-center gap-1 px-3 py-2 text-gray-700 hover:bg-gray-50 hover:text-blue-700">
              <span>イベント</span>
              <span class="text-xs">▾</span>
            </a>
            <ul class="absolute left-0 top-full hidden group-hover:block group-focus-within:block min-w-56 bg-white border border-gray-200 shadow-md z-20">
              <li class="border-b border-gray-100">
                <a href="https://forms.gle/nbBSvZXUkgRXfiA56" class="block px-4 py-2 text-gray-700 hover:bg-gray-50 hover:text-blue-700" title="OpenStreetMapに関するイベント情報を投稿します。">イベント情報を投稿</a>
              </li>
              <li class="border-b border-gray-100">
                <a href="/events/map/" class="block px-4 py-2 text-gray-700 hover:bg-gray-50 hover:text-blue-700">イベント地図</a>
              </li>
              <li>
                <a href="/events/" class="block px-4 py-2 text-gray-700 hover:bg-gray-50 hover:text-blue-700">イベント一覧</a>
              </li>
            </ul>
          </li>
          <li>
            <a href="https://discord.gg/pNuUM99kUX" class="block px-3 py-2 text-gray-700 hover:bg-gray-50 hover:text-blue-700">Discord</a>
          </li>
          <li>
            <a href="/node/751/" class="block px-3 py-2 text-gray-700 hover:bg-gray-50 hover:text-blue-700" title="議論しましょう">掲示板</a>
          </li>
          <li>
            <a href="/node/27/" class="block px-3 py-2 text-gray-700 hover:bg-gray-50 hover:text-blue-700" title="メーリングリストのご案内">ML案内</a>
          </li>
          <li>
            <a href="/node/29/" class="block px-3 py-2 text-gray-700 hover:bg-gray-50 hover:text-blue-700" title="ライセンスとプライバシーポリシーについて">ライセンス</a>
          </li>
          <li>
            <a href="https://www.osmf.jp/" class="block px-3 py-2 text-gray-700 hover:bg-gray-50 hover:text-blue-700">運営組織</a>
          </li>
          <li>
            <a
              href="https://github.com/openstreetmap-japan/openstreetmap-japan.github.io"
              class="flex items-center gap-1 px-3 py-2 text-gray-700 hover:bg-gray-50 hover:text-blue-700"
              title="GitHub リポジトリ"
              target="_blank"
              rel="noopener"
            >
              <svg viewBox="0 0 16 16" class="w-4 h-4" fill="currentColor" aria-hidden="true">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
              </svg>
              <span>GitHub</span>
            </a>
          </li>
        </ul>
      </nav>
    </header>

    <div class="mx-auto max-w-6xl px-4 py-8 grid grid-cols-1 lg:grid-cols-[260px_minmax(0,1fr)] gap-8">
      <aside class="space-y-4 lg:order-first">
        <a
          href="https://www.openstreetmap.org/user/new"
          class="btn btn-primary btn-lg w-full h-auto min-h-0 py-4 flex flex-col items-center justify-center gap-1 text-center leading-tight shadow-sm"
          target="_blank"
          rel="noopener"
        >
          <span class="text-xs opacity-90">OpenStreetMap</span>
          <span class="text-base font-bold">新規アカウント登録 →</span>
        </a>

        <section class="bg-white border border-gray-200 rounded-lg overflow-hidden">
          <h2 class="text-sm font-bold bg-gray-50 border-b border-gray-200 px-4 py-2 text-gray-700">マップを見る</h2>
          <ul class="text-sm">
            <li class="border-b border-gray-100">
              <a href="https://www.openstreetmap.org/#map=5/35.70/141.45" target="_blank" rel="noopener" class="block px-4 py-2 text-blue-700 hover:bg-gray-50">OpenStreetMap</a>
            </li>
            <li class="border-b border-gray-100">
              <a href="https://tile.openstreetmap.jp/styles/openmaptiles#4.46/35.7/141.45" target="_blank" rel="noopener" class="block px-4 py-2 text-blue-700 hover:bg-gray-50">OpenStreetMap Japan Tile Server</a>
            </li>
            <li>
              <a href="https://overpass-turbo.eu/" target="_blank" rel="noopener" class="block px-4 py-2 text-blue-700 hover:bg-gray-50">Overpass Turbo (データ抽出)</a>
            </li>
          </ul>
        </section>

        <section class="bg-white border border-gray-200 rounded-lg overflow-hidden">
          <h2 class="text-sm font-bold bg-gray-50 border-b border-gray-200 px-4 py-2 text-gray-700">外部リンク</h2>
          <ul class="text-sm">
            <li class="border-b border-gray-100">
              <a href="http://learnosm.org/ja/" class="block px-4 py-2 text-blue-700 hover:bg-gray-50" title="LearnOSMでは、OSM初心者を主な対象に、概要や編集方法、利用方法について解説が行われています">LearnOSM</a>
            </li>
            <li class="border-b border-gray-100">
              <a href="https://discord.gg/pNuUM99kUX" class="block px-4 py-2 text-blue-700 hover:bg-gray-50">OpenStreetMap Japan Discord</a>
            </li>
            <li>
              <a href="https://stateofthemap.jp/" class="block px-4 py-2 text-blue-700 hover:bg-gray-50">State of the Map Japan</a>
            </li>
          </ul>
        </section>

        <section class="bg-white border border-gray-200 rounded-lg overflow-hidden">
          <h2 class="text-sm font-bold bg-gray-50 border-b border-gray-200 px-4 py-2 text-gray-700">ガイド</h2>
          <ul class="text-sm">
            <li class="border-b border-gray-100">
              <a href="/node/762/" class="block px-4 py-2 text-blue-700 hover:bg-gray-50">OSM利用入門</a>
            </li>
            <li class="border-b border-gray-100">
              <a href="/node/763/" class="block px-4 py-2 text-blue-700 hover:bg-gray-50">OSM編集入門</a>
              <ul class="text-xs bg-gray-50/40 border-t border-gray-100">
                <li class="border-b border-gray-100">
                  <a href="/node/764/" class="block pl-8 pr-4 py-2 text-blue-700 hover:bg-gray-50">利用可能なデータソース</a>
                </li>
                <li class="border-b border-gray-100">
                  <a href="/node/765/" class="block pl-8 pr-4 py-2 text-blue-700 hover:bg-gray-50">データインポート</a>
                </li>
                <li>
                  <a href="/node/825/" class="block pl-8 pr-4 py-2 text-blue-700 hover:bg-gray-50">CC BY 4.0データの利用申請テンプレート</a>
                </li>
              </ul>
            </li>
            <li class="border-b border-gray-100">
              <a href="/node/766/" class="block px-4 py-2 text-blue-700 hover:bg-gray-50">OSMコミュニティ</a>
            </li>
            <li>
              <a href="/node/767/" class="block px-4 py-2 text-blue-700 hover:bg-gray-50">OSMFJについて</a>
            </li>
          </ul>
        </section>

        <section class="bg-white border border-gray-200 rounded-lg overflow-hidden">
          <h2 class="text-sm font-bold bg-gray-50 border-b border-gray-200 px-4 py-2 text-gray-700">ナビゲーション</h2>
          <ul class="text-sm">
            <li class="border-b border-gray-100">
              <a href="/events/" class="block px-4 py-2 text-blue-700 hover:bg-gray-50">最近の記事</a>
            </li>
            <li>
              <a href="/events/map/" class="block px-4 py-2 text-blue-700 hover:bg-gray-50">イベント地図</a>
            </li>
          </ul>
        </section>
      </aside>

      <main class="min-w-0">
        <slot />
      </main>
    </div>

    <footer class="border-t border-gray-200 bg-white mt-8">
      <div class="mx-auto max-w-6xl px-4 py-6 text-center text-sm text-gray-600">
        Copyright © {new Date().getFullYear()}, OpenStreetMap Japan
      </div>
    </footer>
  </body>
</html>
