---
import { getCollection } from "astro:content";

type FeedItem = {
  kind: "event" | "page";
  title: string;
  href: string;
  date: Date;
  dateLabel: string;
  hero_image?: string;
  venue_text?: string;
};

const events = (await getCollection("events", ({ data }) => !data.draft)).map((e) => {
  const d = new Date(e.data.start);
  return {
    kind: "event",
    title: e.data.title,
    href: `/events/${e.slug}/`,
    date: d,
    dateLabel: d.toLocaleDateString("ja-JP"),
    hero_image: e.data.hero_image,
    venue_text: e.data.venue_text,
  } satisfies FeedItem;
});

const pages = (await getCollection("pages"))
  .filter((p) => !p.data.draft)
  .map((p) => {
    const iso = (p.data.updated ?? p.data.date ?? "") as string;
    const d = iso ? new Date(iso) : new Date(0);
    const slug = (p.data.slug ?? p.slug) as string;
    return {
      kind: "page",
      title: p.data.title,
      href: `/${slug.replace(/^\/+/, "")}/`,
      date: d,
      dateLabel: iso ? d.toLocaleDateString("ja-JP") : "",
      hero_image: p.data.hero_image,
    } satisfies FeedItem;
  });

const latest = [...events, ...pages]
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 10);
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>OpenStreetMap Japan</title>
  </head>

  <body>
    <main style="max-width: 980px; margin: 0 auto; padding: 24px;">
      <h1>OpenStreetMap Japan</h1>

      <section style="margin-top: 24px;">
		<div style="display:flex;justify-content:space-between;align-items:baseline;gap:12px;">
			<h2 style="margin:0;">最新の更新</h2>
			<a href="/events/">一覧へ</a>
		</div>

		<div
			style="
			margin-top: 12px;
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
			gap: 16px;
			"
		>
			{latest.map((item) => (
			<article style="border:1px solid #ddd;border-radius:12px;overflow:hidden;">
				<a href={item.href} style="text-decoration:none;color:inherit;">
				{item.hero_image ? (
					<img
					src={item.hero_image}
					alt=""
					loading="lazy"
					style="display:block;width:100%;height:160px;object-fit:cover;background:#f2f2f2;"
					/>
				) : (
					<div style="height:160px;background:#f2f2f2;"></div>
				)}
				<div style="padding:14px;">
					<div style="font-size:12px;opacity:.8;margin-bottom:6px;display:flex;gap:8px;align-items:center;">
					<span style="padding:2px 8px;border:1px solid #ddd;border-radius:999px;font-size:11px;">
						{item.kind === "event" ? "EVENT" : "PAGE"}
					</span>
					{item.dateLabel && <span>{item.dateLabel}</span>}
					</div>
					<div style="font-weight:700;line-height:1.35;">{item.title}</div>
					{item.kind === "event" && item.venue_text && (
					<div style="margin-top:6px;font-size:13px;opacity:.85;">{item.venue_text}</div>
					)}
				</div>
				</a>
			</article>
			))}
		</div>
	</section>

      <section style="margin-top: 28px;">
        <h2>リンク</h2>
        <ul>
          <li><a href="/events/">イベント</a></li>
          <li><a href="/events/map/">イベント地図</a></li>
        </ul>
      </section>
    </main>
  </body>
</html>