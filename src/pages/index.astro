---
import SiteLayout from "../layouts/SiteLayout.astro";
import { getCollection } from "astro:content";
import { eventTiming } from "../lib/event-time.mjs";

type FeedItem = {
  kind: "event" | "page" | "tool" | "article";
  title: string;
  href: string;
  date: Date;
  dateLabel: string;
  expires?: number;
  hero_image?: string;
  venue_text?: string;
  body: string;
};

function excerpt(raw: string, max = 140): string {
  const stripped = raw
    .replace(/^---[\s\S]*?---/, "")
    .replace(/!\[[^\]]*\]\([^)]*\)/g, "")
    .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
    .replace(/<[^>]+>/g, "")
    .replace(/[#>*_`~]/g, "")
    .replace(/\s+/g, " ")
    .trim();
  return stripped.length > max ? stripped.slice(0, max) + "…" : stripped;
}

const events = (await getCollection("events", ({ data }) => !data.draft)).map((e) => {
  const timing = eventTiming(e.data.start);
  const d = new Date(timing.start);
  // Show period-type events (e.g. submissions) until their end date, not just the start.
  const expires = e.data.end ? eventTiming(e.data.end).expires : timing.expires;
  return {
    kind: "event",
    title: e.data.title,
    href: `/events/${e.id}/`,
    date: d,
    dateLabel: d.toLocaleDateString("ja-JP", { timeZone: "Asia/Tokyo" }),
    expires,
    hero_image: e.data.hero_image,
    venue_text: e.data.venue_text,
    body: excerpt(e.body ?? ""),
  } satisfies FeedItem;
});

const pages = (await getCollection("pages"))
  .filter((p) => !p.data.draft)
  .filter((p) => !!p.data.legacy_node_id)
  .map((p) => {
    const iso = (p.data.updated ?? p.data.date ?? "") as string;
    const d = iso ? new Date(iso) : new Date(0);
    return {
      kind: "page",
      title: p.data.title,
      href: `/node/${p.data.legacy_node_id}/`,
      date: d,
      dateLabel: iso ? d.toLocaleDateString("ja-JP", { timeZone: "Asia/Tokyo" }) : "",
      hero_image: p.data.hero_image,
      body: excerpt(p.body ?? ""),
    } satisfies FeedItem;
  });

const now = Date.now();
const tools = (await getCollection("tools", ({ data }) => !data.draft && !!data.added_date)).map(({ data }) => ({
  kind: "tool" as const,
  title: data.title,
  href: data.url,
  date: new Date(`${data.added_date}T00:00:00+09:00`),
  dateLabel: data.added_date!,
  hero_image: "/images/assets/tool-thumbnail.svg",
  body: data.summary,
}));
const articles = (await getCollection("articles", ({ data }) => !data.draft)).map(({ data }) => ({
  kind: "article" as const,
  title: data.title,
  href: data.url,
  date: new Date(`${data.added_date}T00:00:00+09:00`),
  dateLabel: data.added_date,
  hero_image: "/images/assets/article-thumbnail.svg",
  body: data.summary,
}));
const items: FeedItem[] = [...events.filter((event) => event.expires! > now), ...pages.filter((page) => page.date.getTime() > 0), ...tools, ...articles]
  .sort((a, b) => b.date.getTime() - a.date.getTime() || a.title.localeCompare(b.title, "ja"))
  .slice(0, 15);
const [featured, ...list] = items;
const kindLabel = { event: "イベント", page: "お知らせ", tool: "ツール紹介", article: "記事紹介" };
---

<SiteLayout title="OpenStreetMap Japan | 自由な地図をみんなの手で / The Free Wiki World Map">
  <section aria-labelledby="news-heading">
  <div class="mb-4 flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
    <h1 id="news-heading" class="text-2xl font-bold">お知らせ</h1>
    <a href="https://forms.gle/nbBSvZXUkgRXfiA56" class="ml-auto inline-flex min-h-11 shrink-0 items-center py-2 text-xs text-blue-700 hover:underline sm:text-sm">イベント情報を投稿</a>
  </div>
  {featured && (
    <article data-event-expires={featured.expires} class="bg-white border border-gray-200 rounded-lg overflow-hidden shadow-sm mb-6">
      <a href={featured.href} class="block group">
        {featured.hero_image && (
          <img
            src={featured.hero_image}
            alt=""
            class="w-full h-64 object-cover bg-gray-100"
            loading="eager"
          />
        )}
        <div class="p-5">
          <div class="flex items-center gap-2 text-xs text-gray-500 mb-2">
            <span class="inline-block px-2 py-0.5 border border-gray-300 rounded-full">
              {kindLabel[featured.kind]}
            </span>
            {featured.dateLabel && <span>{featured.kind === "event" ? "開催日" : featured.kind === "page" ? "更新日" : "掲載日"}: {featured.dateLabel}</span>}
            {featured.kind === "event" && featured.venue_text && <span>・ {featured.venue_text}</span>}
          </div>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-blue-700 leading-snug">
            {featured.title}
          </h2>
          {featured.body && (
            <p class="mt-3 text-sm text-gray-700 leading-relaxed">{featured.body}</p>
          )}
          <div class="mt-3 text-sm text-blue-700 group-hover:underline">続きを読む →</div>
        </div>
      </a>
    </article>
  )}

  <ul class="space-y-4">
    {list.map((item) => (
      <li data-event-expires={item.expires}>
        <article class="bg-white border border-gray-200 rounded-lg overflow-hidden shadow-sm">
          <a href={item.href} class="flex flex-col sm:flex-row group">
            {item.hero_image && (
              <div class="sm:w-56 sm:flex-shrink-0">
                <img
                  src={item.hero_image}
                  alt=""
                  class="w-full h-44 sm:h-full object-cover bg-gray-100"
                  loading="lazy"
                />
              </div>
            )}
            <div class="p-4 sm:p-5 flex-1 min-w-0">
              <div class="flex items-center gap-2 text-xs text-gray-500 mb-1">
                <span class="inline-block px-2 py-0.5 border border-gray-300 rounded-full">
                  {kindLabel[item.kind]}
                </span>
                {item.dateLabel && <span>{item.kind === "event" ? "開催日" : item.kind === "page" ? "更新日" : "掲載日"}: {item.dateLabel}</span>}
              </div>
              <h2 class="text-base font-bold text-gray-900 group-hover:text-blue-700 leading-snug">
                {item.title}
              </h2>
              {item.kind === "event" && item.venue_text && (
                <div class="mt-1 text-xs text-gray-600">会場: {item.venue_text}</div>
              )}
              {item.body && (
                <p class="mt-2 text-sm text-gray-700 line-clamp-2">{item.body}</p>
              )}
            </div>
          </a>
        </article>
      </li>
    ))}
  </ul>

  <div class="mt-6 text-center">
    <a href="/events/" class="inline-block px-3 py-2 text-sm text-blue-700 hover:underline">イベント・お知らせ一覧 →</a>
    <a href="/articles/" class="inline-block px-3 py-2 text-sm text-blue-700 hover:underline">記事一覧 →</a>
    <a href="/tools/" class="inline-block px-3 py-2 text-sm text-blue-700 hover:underline">ツール一覧 →</a>
  </div>
  </section>

</SiteLayout>

<script>
  // Static pages can outlive the build: expire events without requiring a new build.
  function updateUpcomingEvents() {
    const now = Date.now();
    const cards = document.querySelectorAll<HTMLElement>("[data-event-expires]");
    cards.forEach((card) => {
      const expired = Number(card.dataset.eventExpires) <= now;
      card.hidden = expired;
    });
  }
  updateUpcomingEvents();
  window.setInterval(updateUpcomingEvents, 60_000);
  document.addEventListener("visibilitychange", updateUpcomingEvents);
</script>
