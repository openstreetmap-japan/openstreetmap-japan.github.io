---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getCollection } from "astro:content";
import EventMap from "../../components/EventMap";

const events = await getCollection("events", ({ data }) => !data.draft);

const points = events
    .filter((e) => typeof e.data.longitude === "number" && typeof e.data.latitude === "number")
    .map((e) => ({
        id: e.id,
        title: e.data.title,
        latitude: e.data.latitude!,
        longitude: e.data.longitude!,
        href: `/events/${e.id}/`,
        venue_text: e.data.venue_text,
        start: e.data.start,
    }));
---

<SiteLayout title="イベント地図 | OpenStreetMap Japan">
    <p class="text-sm mb-4"><a href="/events/" class="text-blue-700 hover:underline">← イベント一覧</a></p>

    <div class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm">
        <h1 class="text-2xl font-bold mb-4">イベント地図</h1>

        {points.length === 0 ? (
            <p class="text-sm text-gray-600">地図上に表示するイベントがありません。</p>
        ) : (
            <EventMap {points} client:only="react" />
        )}
    </div>
</SiteLayout>
