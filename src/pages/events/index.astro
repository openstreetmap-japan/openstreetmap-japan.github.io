---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getCollection } from "astro:content";

type FeedItem = {
  kind: "event" | "page";
  title: string;
  href: string;
  sortMs: number;
  dateLabel: string;
  hero_image?: string;
  venue_text?: string;
};

const events = (await getCollection("events", ({ data }) => !data.draft)).map((e) => {
  const d = new Date(e.data.start);
  return {
    kind: "event",
    title: e.data.title,
    href: `/events/${e.id}/`,
    sortMs: d.getTime(),
    dateLabel: d.toLocaleDateString("ja-JP"),
    hero_image: e.data.hero_image,
    venue_text: e.data.venue_text,
  } satisfies FeedItem;
});

const pages = (await getCollection("pages"))
  .filter((p) => !p.data.draft)
  .filter((p) => !!p.data.legacy_node_id)
  .map((p) => {
    const iso = (p.data.updated ?? p.data.date ?? "") as string;
    const ms = iso ? new Date(iso).getTime() : Number(p.data.legacy_node_id);
    const label = iso ? new Date(iso).toLocaleDateString("ja-JP") : "";
    return {
      kind: "page",
      title: p.data.title,
      href: `/node/${p.data.legacy_node_id}/`,
      sortMs: iso ? ms : 1_700_000_000_000 + ms,
      dateLabel: label,
      hero_image: p.data.hero_image,
    } satisfies FeedItem;
  });

const items = [...events, ...pages].sort((a, b) => b.sortMs - a.sortMs);

const PER_PAGE = 10;
const totalPages = Math.max(1, Math.ceil(items.length / PER_PAGE));
const initialSlice = items.slice(0, PER_PAGE);
---

<SiteLayout title="イベント・ページ一覧 | OpenStreetMap Japan">
  <h1 class="text-2xl font-bold mb-2">イベント・ページ一覧</h1>

  <p class="mb-4 text-sm">
    <a href="/events/map/" class="text-blue-700 hover:underline">イベント地図</a>
  </p>

  <ul id="feed" class="space-y-4">
    {initialSlice.map((item) => (
      <li>
        <article class="bg-white border border-gray-200 rounded-lg overflow-hidden shadow-sm">
          <a href={item.href} class="flex flex-col sm:flex-row group">
            <div class="sm:w-56 sm:flex-shrink-0">
              {item.hero_image ? (
                <img
                  src={item.hero_image}
                  alt=""
                  class="w-full h-44 sm:h-full object-cover bg-gray-100"
                  loading="lazy"
                />
              ) : (
                <div class="w-full h-44 sm:h-full bg-gray-100" />
              )}
            </div>
            <div class="p-4 sm:p-5 flex-1 min-w-0">
              <div class="flex items-center gap-2 text-xs text-gray-500 mb-1">
                <span class="inline-block px-2 py-0.5 border border-gray-300 rounded-full">
                  {item.kind === "event" ? "イベント" : "お知らせ"}
                </span>
                {item.dateLabel && <span>{item.dateLabel}</span>}
              </div>
              <h2 class="text-base font-bold text-gray-900 group-hover:text-blue-700 leading-snug">
                {item.title}
              </h2>
              {item.kind === "event" && item.venue_text && (
                <div class="mt-1 text-xs text-gray-600">会場: {item.venue_text}</div>
              )}
            </div>
          </a>
        </article>
      </li>
    ))}
  </ul>

  <nav id="pager" class="mt-6 flex items-center justify-center gap-4 text-sm">
    <a id="prev" href="?page=1" class="text-blue-700 hover:underline pointer-events-none opacity-50">← 前へ</a>
    <span id="pageinfo" class="text-gray-600">1 / {totalPages}</span>
    <a
      id="next"
      href="?page=2"
      class={`text-blue-700 hover:underline ${totalPages >= 2 ? "" : "pointer-events-none opacity-50"}`}
    >
      次へ →
    </a>
  </nav>

  <script type="application/json" id="items-json" is:inline set:html={JSON.stringify(items)} />

  <script>
    (function () {
      const perPage = 10;
      const items = JSON.parse(document.getElementById("items-json")!.textContent!);
      const params = new URLSearchParams(location.search);
      const page = Math.max(1, parseInt(params.get("page") || "1", 10) || 1);
      const totalPages = Math.max(1, Math.ceil(items.length / perPage));
      const safePage = Math.min(page, totalPages);

      function escapeHtml(s: string): string {
        return s.replace(/[&<>"']/g, (c) =>
          c === "&" ? "&amp;" : c === "<" ? "&lt;" : c === ">" ? "&gt;" : c === '"' ? "&quot;" : "&#39;"
        );
      }

      type Item = {
        kind: "event" | "page";
        title: string;
        href: string;
        dateLabel: string;
        hero_image?: string;
        venue_text?: string;
      };

      function cardHtml(item: Item): string {
        const img = item.hero_image
          ? `<img src="${escapeHtml(item.hero_image)}" alt="" loading="lazy" class="w-full h-44 sm:h-full object-cover bg-gray-100">`
          : `<div class="w-full h-44 sm:h-full bg-gray-100"></div>`;
        const venue =
          item.kind === "event" && item.venue_text
            ? `<div class="mt-1 text-xs text-gray-600">会場: ${escapeHtml(item.venue_text)}</div>`
            : "";
        const date = item.dateLabel ? `<span>${escapeHtml(item.dateLabel)}</span>` : "";
        const badge = item.kind === "event" ? "イベント" : "お知らせ";
        return (
          `<li><article class="bg-white border border-gray-200 rounded-lg overflow-hidden shadow-sm">` +
          `<a href="${escapeHtml(item.href)}" class="flex flex-col sm:flex-row group">` +
          `<div class="sm:w-56 sm:flex-shrink-0">${img}</div>` +
          `<div class="p-4 sm:p-5 flex-1 min-w-0">` +
          `<div class="flex items-center gap-2 text-xs text-gray-500 mb-1">` +
          `<span class="inline-block px-2 py-0.5 border border-gray-300 rounded-full">${badge}</span>` +
          `${date}</div>` +
          `<h2 class="text-base font-bold text-gray-900 group-hover:text-blue-700 leading-snug">${escapeHtml(item.title)}</h2>` +
          `${venue}` +
          `</div></a></article></li>`
        );
      }

      function render() {
        const start = (safePage - 1) * perPage;
        const slice = items.slice(start, start + perPage) as Item[];

        const feed = document.getElementById("feed")!;
        feed.innerHTML = slice.map(cardHtml).join("");

        const prev = document.getElementById("prev") as HTMLAnchorElement;
        const next = document.getElementById("next") as HTMLAnchorElement;
        const info = document.getElementById("pageinfo")!;

        info.textContent = safePage + " / " + totalPages;

        if (safePage > 1) {
          prev.href = "?page=" + (safePage - 1);
          prev.classList.remove("pointer-events-none", "opacity-50");
        } else {
          prev.href = "?page=1";
          prev.classList.add("pointer-events-none", "opacity-50");
        }

        if (safePage < totalPages) {
          next.href = "?page=" + (safePage + 1);
          next.classList.remove("pointer-events-none", "opacity-50");
        } else {
          next.href = "?page=" + totalPages;
          next.classList.add("pointer-events-none", "opacity-50");
        }
      }

      render();
    })();
  </script>

  <noscript>
    <p class="mt-4 text-sm text-gray-600">ページ送り（?page=2 など）にはJavaScriptが必要です。</p>
  </noscript>
</SiteLayout>
