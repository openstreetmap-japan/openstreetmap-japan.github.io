---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getCollection } from "astro:content";

const notices = (await getCollection("pages", ({ data }) => !data.draft && !!data.legacy_node_id))
  .map((entry) => {
    const iso = entry.data.updated ?? entry.data.date;
    const timestamp = iso ? Date.parse(iso) : NaN;
    return { ...entry, timestamp: Number.isFinite(timestamp) ? timestamp : 0 };
  })
  .sort((a, b) => b.timestamp - a.timestamp || b.id.localeCompare(a.id, "ja", { numeric: true }));
---

<SiteLayout title="お知らせ一覧 | OpenStreetMap Japan" description="OpenStreetMap Japanからのお知らせや活動紹介の一覧です。">
  <h1 class="text-2xl font-bold mb-4">お知らせ一覧</h1>
  <p class="mb-4 text-sm text-gray-600">日付のあるお知らせは新しい順に表示しています。日付のない過去のページは最後に表示します。</p>
  <ul class="space-y-4">
    {notices.map(({ data, timestamp }) => (
      <li>
        <article class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
          {timestamp > 0 && <p class="mb-2 text-xs text-gray-500">{new Date(timestamp).toLocaleDateString("ja-JP", { timeZone: "Asia/Tokyo" })}</p>}
          <h2 class="font-bold"><a href={`/node/${data.legacy_node_id}/`} class="text-blue-700 hover:underline">{data.title}</a></h2>
        </article>
      </li>
    ))}
  </ul>
</SiteLayout>
