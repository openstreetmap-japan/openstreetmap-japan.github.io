---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getCollection } from "astro:content";
import { toolCategories } from "../../lib/tool-categories";

const tools = (await getCollection("tools", ({ data }) => !data.draft))
  .sort((a, b) => a.data.title.localeCompare(b.data.title, "ja") || a.id.localeCompare(b.id));
const getCategories = (categories: readonly string[]) => categories.length > 0 ? categories : ["その他"];
const categories = toolCategories.map((category) => ({
  category,
  count: tools.filter(({ data }) => getCategories(data.category).includes(category)).length,
})).filter(({ count }) => count > 0);
---

<SiteLayout title="ツール紹介 | OpenStreetMap Japan" description="OpenStreetMapの閲覧、編集、現地調査やデータ活用に役立つツールを紹介します。">
  <h1 class="text-2xl font-bold mb-2">ツール紹介</h1>
  <p class="mb-6 text-sm text-gray-600"><a href="https://discord.gg/pNuUM99kUX" class="text-blue-700 underline hover:text-blue-900">Discord</a>で紹介されたOpenStreetMap関連のツールやサービスを紹介します。</p>

  {tools.length > 0 ? (
    <>
      <div id="tool-filters" hidden>
        <div role="group" aria-label="ツールのカテゴリで絞り込み" class="mb-3 flex flex-wrap gap-2">
          <button type="button" class="tool-filter" data-filter-category="" aria-pressed="true" aria-controls="tool-results">すべて（{tools.length}）</button>
          {categories.map(({ category, count }) => (
            <button type="button" class="tool-filter" data-filter-category={category} aria-pressed="false" aria-controls="tool-results">{category}（{count}）</button>
          ))}
        </div>
      </div>
      <p id="tool-count" class="mb-4 text-sm text-gray-600" aria-live="polite" aria-atomic="true">{tools.length}件のツール・サービス</p>
      <ul id="tool-results" class="space-y-4">
        {tools.map(({ data }) => (
          <li data-tool-categories={JSON.stringify(getCategories(data.category))}>
            <article class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
              <p class="mb-2 text-xs text-gray-500">{getCategories(data.category).join(" / ")}</p>
              <h2 class="text-lg font-bold leading-snug break-words">
                <a href={data.url} class="text-blue-700 hover:underline">{data.title} <span class="text-sm font-normal">↗</span><span class="sr-only">（外部サイト）</span></a>
              </h2>
              <p class="mt-3 text-sm text-gray-700 leading-relaxed break-words">{data.summary}</p>
              {data.platforms.length > 0 && (
                <p class="mt-3 text-xs text-gray-500">利用環境: {data.platforms.join(" / ")}</p>
              )}
            </article>
          </li>
        ))}
      </ul>
    </>
  ) : (
    <p class="rounded-lg border border-gray-200 bg-white p-5 text-sm text-gray-600">ツールはまだ登録されていません。</p>
  )}
</SiteLayout>


<script>
  const filters = document.getElementById("tool-filters");
  const results = document.getElementById("tool-results");
  const count = document.getElementById("tool-count");

  if (filters && results && count) {
    const buttons = filters.querySelectorAll<HTMLButtonElement>("[data-filter-category]");
    const items = [...results.querySelectorAll<HTMLLIElement>("[data-tool-categories]")]
      .map((element) => ({ element, categories: JSON.parse(element.dataset.toolCategories!) as string[] }));
    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const category = button.dataset.filterCategory ?? "";
        let visible = 0;
        items.forEach(({ element, categories }) => {
          element.hidden = category !== "" && !categories.includes(category);
          if (!element.hidden) visible++;
        });
        buttons.forEach((other) => other.setAttribute("aria-pressed", String(other === button)));
        count.textContent = `${visible}件のツール・サービス`;
      });
    });
    filters.hidden = false;
  }
</script>

<style>
  .tool-filter {
    min-height: 44px;
    padding: 0.5rem 0.875rem;
    border: 1px solid #d1d5db;
    border-radius: 9999px;
    background: white;
    color: #374151;
    font-size: 0.875rem;
    cursor: pointer;
  }
  .tool-filter[aria-pressed="true"] {
    border-color: #1d4ed8;
    background: #1d4ed8;
    color: white;
  }
  .tool-filter:focus-visible {
    outline: 2px solid #1d4ed8;
    outline-offset: 2px;
  }
</style>
