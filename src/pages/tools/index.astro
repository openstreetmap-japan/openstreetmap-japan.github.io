---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getCollection } from "astro:content";
import { toolCategories } from "../../lib/tool-categories";

const tools = (await getCollection("tools", ({ data }) => !data.draft))
  .sort((a, b) => a.data.title.localeCompare(b.data.title, "ja") || a.id.localeCompare(b.id));
const groups = toolCategories.map((category, index) => ({
  category,
  id: `tool-category-${index}`,
  items: tools.filter(({ data }) => data.category === category),
})).filter(({ items }) => items.length > 0);
---

<SiteLayout title="ツール集 | OpenStreetMap Japan" description="OpenStreetMapの閲覧、編集、現地調査やデータ活用に役立つツールを紹介します。">
  <h1 class="text-2xl font-bold mb-2">ツール集</h1>
  <p class="mb-6 text-sm text-gray-600">地図を見る、編集する、データを使う。目的に合ったツールを探せます。</p>

  {groups.length > 0 ? (
    <>
      <nav aria-label="ツールの分類" class="mb-8 flex flex-wrap gap-2">
        {groups.map((group) => (
          <a href={`#${group.id}`} class="rounded-full border border-gray-300 bg-white px-3 py-2 text-sm text-blue-700 hover:bg-gray-50">
            {group.category}（{group.items.length}）
          </a>
        ))}
      </nav>
      <div class="space-y-8">
        {groups.map((group) => (
          <section aria-labelledby={group.id}>
            <h2 id={group.id} class="text-xl font-bold mb-4 scroll-mt-4">{group.category}</h2>
            <ul class="space-y-4">
              {group.items.map(({ data }) => (
                <li>
                  <article class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
                    <h3 class="text-lg font-bold leading-snug break-words">
                      <a href={data.url} class="text-blue-700 hover:underline">{data.title} <span class="text-sm font-normal">↗</span><span class="sr-only">（外部サイト）</span></a>
                    </h3>
                    <p class="mt-3 text-sm text-gray-700 leading-relaxed break-words">{data.summary}</p>
                    {data.platforms.length > 0 && (
                      <p class="mt-3 text-xs text-gray-500">利用環境: {data.platforms.join(" / ")}</p>
                    )}
                  </article>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </>
  ) : (
    <p class="rounded-lg border border-gray-200 bg-white p-5 text-sm text-gray-600">ツールはまだ登録されていません。</p>
  )}
</SiteLayout>
