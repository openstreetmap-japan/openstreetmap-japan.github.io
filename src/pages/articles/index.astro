---
import SiteLayout from "../../layouts/SiteLayout.astro";
import ArticleList from "../../components/ArticleList.astro";
import { getCollection } from "astro:content";

const articles = (await getCollection("articles", ({ data }) => !data.draft))
  .sort((a, b) => b.data.added_date.localeCompare(a.data.added_date) || b.id.localeCompare(a.id));
const categoryCounts = new Map<string, number>();
for (const { data } of articles) {
  const category = data.category?.trim() || "その他";
  categoryCounts.set(category, (categoryCounts.get(category) ?? 0) + 1);
}
const categories = [...categoryCounts].sort(([a], [b]) => a.localeCompare(b, "ja"));
---

<SiteLayout title="記事紹介 | OpenStreetMap Japan" description="OpenStreetMapの入門、編集、データ活用や活動に関する記事を紹介します。">
  <h1 class="text-2xl font-bold mb-2">記事紹介</h1>
  <p class="mb-6 text-sm text-gray-600"><a href="https://discord.gg/pNuUM99kUX" class="text-blue-700 underline hover:text-blue-900">Discord</a>で紹介されたOpenStreetMap関連の記事を紹介します。</p>
  {articles.length > 0 ? (
    <>
      <div id="article-filters" hidden>
        <label for="article-search" class="mb-2 block text-sm font-bold">キーワード検索</label>
        <input id="article-search" type="search" placeholder="タイトル・サマリー・URLを検索" aria-controls="article-results" aria-describedby="article-search-help" class="mb-2 w-full rounded-lg border border-gray-300 bg-white px-3 py-3 text-base focus:outline-2 focus:outline-blue-700" />
        <p id="article-search-help" class="mb-4 text-xs text-gray-600">スペースで区切ると、すべてのキーワードを含む記事を表示します。カテゴリと組み合わせて検索できます。</p>
        <div role="group" aria-label="記事のカテゴリで絞り込み" class="mb-3 flex flex-wrap gap-2">
          <button type="button" class="article-filter" data-filter-category="" aria-pressed="true" aria-controls="article-results">すべて（{articles.length}）</button>
          {categories.map(([category, count]) => (
            <button type="button" class="article-filter" data-filter-category={category} aria-pressed="false" aria-controls="article-results">{category}（{count}）</button>
          ))}
        </div>
      </div>
      <p id="article-count" class="mb-4 text-sm text-gray-600" aria-live="polite" aria-atomic="true">{articles.length}件の記事</p>
      <p id="article-empty" hidden class="mb-4 text-sm text-gray-600">条件に一致する記事はありません。キーワードやカテゴリを変更してください。</p>
      <div id="article-results">
        <ArticleList articles={articles} />
      </div>
    </>
  ) : (
    <p class="rounded-lg border border-gray-200 bg-white p-5 text-sm text-gray-600">紹介記事はまだありません。</p>
  )}
</SiteLayout>

<script>
  const filters = document.getElementById("article-filters");
  const results = document.getElementById("article-results");
  const count = document.getElementById("article-count");
  const search = document.querySelector<HTMLInputElement>("#article-search");
  const empty = document.getElementById("article-empty");

  if (filters && results && count && search && empty) {
    const normalize = (value: string) => value.normalize("NFKC").toLocaleLowerCase("ja");
    const buttons = filters.querySelectorAll<HTMLButtonElement>("[data-filter-category]");
    const items = [...results.querySelectorAll<HTMLLIElement>("[data-article-category]")].map((element) => ({
      element,
      category: element.dataset.articleCategory ?? "その他",
      searchText: normalize([element.dataset.articleTitle, element.dataset.articleSummary, element.dataset.articleUrl].join("\n")),
    }));
    let category = "";
    const update = () => {
      const keywords = normalize(search.value).trim().split(/\s+/).filter(Boolean);
      let visible = 0;
      items.forEach((item) => {
        item.element.hidden = (category !== "" && item.category !== category)
          || !keywords.every((keyword) => item.searchText.includes(keyword));
        if (!item.element.hidden) visible++;
      });
      buttons.forEach((button) => button.setAttribute("aria-pressed", String((button.dataset.filterCategory ?? "") === category)));
      count.textContent = `${visible}件の記事`;
      empty.hidden = visible !== 0;
    };
    search.addEventListener("input", update);
    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        category = button.dataset.filterCategory ?? "";
        update();
      });
    });
    update();
    filters.hidden = false;
  }
</script>

<style>
  .article-filter {
    min-height: 44px;
    padding: 0.5rem 0.875rem;
    border: 1px solid #d1d5db;
    border-radius: 9999px;
    background: white;
    color: #374151;
    font-size: 0.875rem;
    cursor: pointer;
  }
  .article-filter[aria-pressed="true"] {
    border-color: #1d4ed8;
    background: #1d4ed8;
    color: white;
  }
  .article-filter:focus-visible {
    outline: 2px solid #1d4ed8;
    outline-offset: 2px;
  }
</style>
