---
import SiteLayout from "../../layouts/SiteLayout.astro";
import ArticleList from "../../components/ArticleList.astro";
import { getCollection } from "astro:content";

const articles = (await getCollection("articles", ({ data }) => !data.draft))
  .sort((a, b) => b.data.added_date.localeCompare(a.data.added_date) || b.id.localeCompare(a.id));
const categoryCounts = new Map<string, number>();
for (const { data } of articles) {
  const category = data.category?.trim() || "その他";
  categoryCounts.set(category, (categoryCounts.get(category) ?? 0) + 1);
}
const categories = [...categoryCounts].sort(([a], [b]) => a.localeCompare(b, "ja"));
---

<SiteLayout title="記事紹介 | OpenStreetMap Japan" description="OpenStreetMapの入門、編集、データ活用や活動に関する記事を紹介します。">
  <h1 class="text-2xl font-bold mb-2">記事紹介</h1>
  <p class="mb-6 text-sm text-gray-600">Discordで紹介されたOpenStreetMap関連の記事を紹介します。</p>
  {articles.length > 0 ? (
    <>
      <div id="article-filters" hidden>
        <div role="group" aria-label="記事のカテゴリで絞り込み" class="mb-3 flex flex-wrap gap-2">
          <button type="button" class="article-filter" data-filter-category="" aria-pressed="true" aria-controls="article-results">すべて（{articles.length}）</button>
          {categories.map(([category, count]) => (
            <button type="button" class="article-filter" data-filter-category={category} aria-pressed="false" aria-controls="article-results">{category}（{count}）</button>
          ))}
        </div>
      </div>
      <p id="article-count" class="mb-4 text-sm text-gray-600" aria-live="polite" aria-atomic="true">{articles.length}件の記事</p>
      <div id="article-results">
        <ArticleList articles={articles} />
      </div>
    </>
  ) : (
    <p class="rounded-lg border border-gray-200 bg-white p-5 text-sm text-gray-600">紹介記事はまだありません。</p>
  )}
</SiteLayout>

<script>
  const filters = document.getElementById("article-filters");
  const results = document.getElementById("article-results");
  const count = document.getElementById("article-count");

  if (filters && results && count) {
    const buttons = filters.querySelectorAll<HTMLButtonElement>("[data-filter-category]");
    const items = results.querySelectorAll<HTMLLIElement>("[data-article-category]");
    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const category = button.dataset.filterCategory ?? "";
        let visible = 0;
        items.forEach((item) => {
          item.hidden = category !== "" && item.dataset.articleCategory !== category;
          if (!item.hidden) visible++;
        });
        buttons.forEach((other) => other.setAttribute("aria-pressed", String(other === button)));
        count.textContent = `${visible}件の記事`;
      });
    });
    filters.hidden = false;
  }
</script>

<style>
  .article-filter {
    min-height: 44px;
    padding: 0.5rem 0.875rem;
    border: 1px solid #d1d5db;
    border-radius: 9999px;
    background: white;
    color: #374151;
    font-size: 0.875rem;
    cursor: pointer;
  }
  .article-filter[aria-pressed="true"] {
    border-color: #1d4ed8;
    background: #1d4ed8;
    color: white;
  }
  .article-filter:focus-visible {
    outline: 2px solid #1d4ed8;
    outline-offset: 2px;
  }
</style>
